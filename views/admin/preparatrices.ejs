<!DOCTYPE html>
<html lang="fr">
<head>
  <%- include('../partials/head', { title: 'Préparatrices — Back-office NewMedica' }) %>
</head>
<body class="min-h-screen bg-nm-bg">
  <%- include('../partials/admin-mobile-nav', { page }) %>
  <div class="flex flex-col md:flex-row">
    <%- include('../partials/admin-sidebar', { page, admin }) %>

    <main class="flex-1 p-6 md:p-8 max-w-6xl">
      <h1 class="text-2xl font-bold text-nm-primary mb-6">Préparatrices</h1>

      <div class="grid lg:grid-cols-3 gap-6">
        <div class="lg:col-span-2 nm-card p-4 overflow-x-auto">
          <table class="w-full text-sm">
            <thead>
              <tr class="text-left text-xs text-gray-400 border-b">
                <th class="py-2">Nom</th><th>Pharmacie</th><th>Email</th><th>Statut</th><th></th>
              </tr>
            </thead>
            <tbody>
              <% preparatrices.forEach(p => { %>
                <tr class="border-b last:border-0" id="row-<%= p.id %>">
                  <td class="py-2.5 font-semibold text-nm-primary"><%= p.prenom %> <%= p.nom %></td>
                  <td class="text-gray-500"><%= p.pharmacie_nom %></td>
                  <td class="text-gray-500"><%= p.email %></td>
                  <td>
                    <span class="badge-pill <%= p.statut === 'actif' ? '' : 'bg-red-50 text-red-500' %>"><%= p.statut %></span>
                  </td>
                  <td class="text-right">
                    <% if (admin.role !== 'marque_lecture') { %>
                    <button class="btn-toggle-statut text-xs text-nm-primary underline" data-id="<%= p.id %>">
                      <%= p.statut === 'actif' ? 'Désactiver' : 'Activer' %>
                    </button>
                    <% } %>
                  </td>
                </tr>
              <% }) %>
              <% if (preparatrices.length === 0) { %><tr><td colspan="5" class="text-gray-400 py-4 text-center">Aucune préparatrice.</td></tr><% } %>
            </tbody>
          </table>
        </div>

        <% if (admin.role !== 'marque_lecture') { %>
        <div class="space-y-6">
          <div class="nm-card p-5">
            <h2 class="font-bold text-nm-primary mb-3">Ajouter une préparatrice</h2>
            <form method="POST" action="/admin/preparatrices" class="space-y-3 text-sm">
              <div class="grid grid-cols-2 gap-2">
                <div>
                  <label class="text-xs font-semibold text-gray-500">Prénom</label>
                  <input name="prenom" required class="mt-1 w-full border border-gray-200 rounded-lg px-3 py-2 text-sm" />
                </div>
                <div>
                  <label class="text-xs font-semibold text-gray-500">Nom</label>
                  <input name="nom" required class="mt-1 w-full border border-gray-200 rounded-lg px-3 py-2 text-sm" />
                </div>
              </div>
              <div>
                <label class="text-xs font-semibold text-gray-500">Email</label>
                <input type="email" name="email" required class="mt-1 w-full border border-gray-200 rounded-lg px-3 py-2 text-sm" />
              </div>
              <div>
                <label class="text-xs font-semibold text-gray-500">Téléphone</label>
                <input name="telephone" class="mt-1 w-full border border-gray-200 rounded-lg px-3 py-2 text-sm" />
              </div>
              <div>
                <label class="text-xs font-semibold text-gray-500">Pharmacie</label>
                <select name="pharmacie_id" required class="mt-1 w-full border border-gray-200 rounded-lg px-3 py-2 text-sm">
                  <% pharmacies.forEach(ph => { %><option value="<%= ph.id %>"><%= ph.nom %></option><% }) %>
                </select>
              </div>
              <div>
                <label class="text-xs font-semibold text-gray-500">Date d'entrée</label>
                <input type="date" name="date_entree" class="mt-1 w-full border border-gray-200 rounded-lg px-3 py-2 text-sm" />
              </div>
              <p class="text-[11px] text-gray-400">Mot de passe initial : <code>newmedica123</code></p>
              <button type="submit" class="w-full bg-nm-primary text-white font-semibold rounded-lg py-2.5 text-sm">Créer</button>
            </form>
          </div>

          <div class="nm-card p-5">
            <h2 class="font-bold text-nm-primary mb-2">Import en masse (CSV)</h2>
            <p class="text-[11px] text-gray-400 mb-3">Colonnes attendues : <code>prenom,nom,email,telephone,pharmacie,date_entree</code>. Le nom de pharmacie doit correspondre exactement à une pharmacie existante.</p>
            <form method="POST" action="/admin/preparatrices/import" enctype="multipart/form-data" class="space-y-3 text-sm">
              <input type="file" name="fichier" accept=".csv" required class="w-full text-xs" />
              <button type="submit" class="w-full bg-nm-accent text-white font-semibold rounded-lg py-2.5 text-sm">Importer</button>
            </form>
            <% if (typeof importees !== 'undefined') { %>
              <p class="text-xs text-emerald-500 mt-2"><%= importees %> préparatrice(s) importée(s).</p>
            <% } %>
          </div>
        </div>
        <% } %>
      </div>
    </main>
  </div>

  <script src="/js/admin.js"></script>
</body>
</html>
