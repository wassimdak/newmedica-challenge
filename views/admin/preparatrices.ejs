<!DOCTYPE html>
<html lang="fr">
<head>
  <%- include('../partials/head', { title: 'Préparatrices — Back-office NewMedica' }) %>
</head>
<body class="min-h-screen bg-nm-bg">
  <%- include('../partials/admin-mobile-nav', { page }) %>
  <div class="flex flex-col md:flex-row">
    <%- include('../partials/admin-sidebar', { page, admin }) %>

    <main class="flex-1 p-6 md:p-8 max-w-6xl">
      <h1 class="text-2xl font-bold text-nm-primary mb-6">Préparatrices</h1>

      <% if (typeof erreurCreation !== 'undefined' && erreurCreation) { %>
        <div class="bg-red-50 text-red-600 text-sm rounded-lg px-4 py-3 mb-4"><%= erreurCreation %></div>
      <% } %>

      <% if (typeof nouveauMdp !== 'undefined' && nouveauMdp) { %>
        <div class="nm-card p-4 mb-4 border-l-4 border-nm-accent">
          <p class="text-sm font-semibold text-nm-primary">Compte créé : <%= nouveauEmail %></p>
          <p class="text-sm mt-1">Mot de passe initial : <code class="bg-nm-bg px-2 py-1 rounded font-bold text-nm-accent"><%= nouveauMdp %></code></p>
          <p class="text-[11px] text-gray-400 mt-1">À communiquer à la préparatrice par un canal sûr — il ne sera plus jamais affiché. Elle devra en choisir un nouveau à sa première connexion.</p>
        </div>
      <% } %>
      <% if (typeof identifiants !== 'undefined' && identifiants.length > 0) { %>
        <div class="nm-card p-4 mb-4 border-l-4 border-nm-accent overflow-x-auto">
          <p class="text-sm font-semibold text-nm-primary mb-2"><%= identifiants.length %> compte(s) créé(s) — mots de passe initiaux :</p>
          <table class="text-sm">
            <% identifiants.forEach(i => { %>
              <tr>
                <td class="pr-4 text-gray-600"><%= i.email %></td>
                <td><code class="bg-nm-bg px-2 py-0.5 rounded font-bold text-nm-accent"><%= i.motDePasse %></code></td>
              </tr>
            <% }) %>
          </table>
          <p class="text-[11px] text-gray-400 mt-2">À communiquer à chaque préparatrice par un canal sûr — cette liste ne sera plus affichée après avoir quitté cette page.</p>
        </div>
      <% } %>

      <div class="grid lg:grid-cols-3 gap-6">
        <div class="lg:col-span-2 nm-card p-4 overflow-x-auto">
          <table class="w-full text-sm">
            <thead>
              <tr class="text-left text-xs text-gray-400 border-b">
                <th class="py-2">Nom</th><th>Pharmacie</th><th>Email</th><th>Statut</th><th></th>
              </tr>
            </thead>
            <tbody>
              <% preparatrices.forEach(p => { %>
                <tr class="border-b last:border-0" id="row-<%= p.id %>">
                  <td class="py-2.5 font-semibold text-nm-primary"><%= p.prenom %> <%= p.nom %></td>
                  <td class="text-gray-500"><%= p.pharmacie_nom %></td>
                  <td class="text-gray-500"><%= p.email %></td>
                  <td>
                    <span class="badge-pill <%= p.statut === 'actif' ? '' : 'bg-red-50 text-red-500' %>"><%= p.statut %></span>
                  </td>
                  <td class="text-right whitespace-nowrap">
                    <% if (admin.role !== 'marque_lecture') { %>
                    <button class="btn-toggle-statut text-xs text-nm-primary underline" data-id="<%= p.id %>">
                      <%= p.statut === 'actif' ? 'Désactiver' : 'Activer' %>
                    </button>
                    <span class="text-gray-300 mx-1">·</span>
                    <form method="POST" action="/admin/preparatrices/<%= p.id %>/reset-mdp" class="inline"
                      onsubmit="return confirm('Générer un nouveau mot de passe pour <%= p.prenom %> <%= p.nom %> ? L\'ancien cessera de fonctionner.')">
                      <button type="submit" class="text-xs text-nm-primary underline">Réinitialiser mdp</button>
                    </form>
                    <% if (p.statut === 'actif') { %>
                    <span class="text-gray-300 mx-1">·</span>
                    <form method="POST" action="/admin/preparatrices/<%= p.id %>/impersonate" class="inline">
                      <button type="submit" class="text-xs text-nm-accent underline">Se connecter en tant que</button>
                    </form>
                    <% } %>
                    <% } %>
                  </td>
                </tr>
              <% }) %>
              <% if (preparatrices.length === 0) { %><tr><td colspan="5" class="text-gray-400 py-4 text-center">Aucune préparatrice.</td></tr><% } %>
            </tbody>
          </table>
        </div>

        <% if (admin.role !== 'marque_lecture') { %>
        <div class="space-y-6">
          <div class="nm-card p-5">
            <h2 class="font-bold text-nm-primary mb-3">Ajouter une préparatrice</h2>
            <form method="POST" action="/admin/preparatrices" id="form-nouvelle-preparatrice" class="space-y-3 text-sm">
              <div class="grid grid-cols-2 gap-2">
                <div>
                  <label class="text-xs font-semibold text-gray-500">Prénom</label>
                  <input name="prenom" required class="mt-1 w-full border border-gray-200 rounded-lg px-3 py-2 text-sm" />
                </div>
                <div>
                  <label class="text-xs font-semibold text-gray-500">Nom</label>
                  <input name="nom" required class="mt-1 w-full border border-gray-200 rounded-lg px-3 py-2 text-sm" />
                </div>
              </div>
              <div>
                <label class="text-xs font-semibold text-gray-500">Email</label>
                <input type="email" name="email" required class="mt-1 w-full border border-gray-200 rounded-lg px-3 py-2 text-sm" />
              </div>
              <div>
                <label class="text-xs font-semibold text-gray-500">Téléphone</label>
                <input name="telephone" class="mt-1 w-full border border-gray-200 rounded-lg px-3 py-2 text-sm" />
              </div>
              <div class="relative">
                <label class="text-xs font-semibold text-gray-500">Pharmacie</label>
                <input type="text" id="pharmacie-recherche" autocomplete="off" required
                  placeholder="Tapez pour rechercher…"
                  class="mt-1 w-full border border-gray-200 rounded-lg px-3 py-2 text-sm" />
                <ul id="pharmacie-resultats" class="hidden absolute z-10 left-0 right-0 mt-1 bg-white border border-gray-200 rounded-lg shadow-md max-h-48 overflow-y-auto text-sm"></ul>
                <input type="hidden" name="pharmacie_id" id="pharmacie-id" />
                <p id="pharmacie-erreur" class="hidden text-[11px] text-red-500 mt-1">Cliquez sur une pharmacie dans les résultats de recherche (ou créez-la ci-dessous).</p>
                <button type="button" id="btn-nouvelle-pharmacie" class="text-[11px] text-nm-primary underline mt-1">+ Nouvelle pharmacie</button>
                <script id="pharmacies-data" type="application/json"><%- JSON.stringify(pharmacies.map(p => ({ id: p.id, nom: p.nom }))) %></script>

                <div id="nouvelle-pharmacie-form" class="hidden mt-2 p-3 bg-nm-bg rounded-lg space-y-2">
                  <input type="text" id="np-nom" placeholder="Nom de la pharmacie" class="w-full border border-gray-200 rounded-lg px-3 py-2 text-sm" />
                  <select id="np-region" class="w-full border border-gray-200 rounded-lg px-3 py-2 text-sm">
                    <option value="">Région (optionnel)</option>
                    <% regions.forEach(r => { %><option value="<%= r.id %>"><%= r.nom %></option><% }) %>
                  </select>
                  <button type="button" id="btn-creer-pharmacie" class="w-full bg-nm-primary text-white font-semibold rounded-lg py-2 text-xs">Créer et sélectionner</button>
                  <p id="np-erreur" class="hidden text-[11px] text-red-500"></p>
                </div>
              </div>
              <div>
                <label class="text-xs font-semibold text-gray-500">Date d'entrée</label>
                <input type="date" name="date_entree" class="mt-1 w-full border border-gray-200 rounded-lg px-3 py-2 text-sm" />
              </div>
              <p class="text-[11px] text-gray-400">Un mot de passe initial est généré automatiquement et affiché une seule fois après la création.</p>
              <button type="submit" class="w-full bg-nm-primary text-white font-semibold rounded-lg py-2.5 text-sm">Créer</button>
            </form>
          </div>

          <div class="nm-card p-5">
            <h2 class="font-bold text-nm-primary mb-2">Import en masse (CSV)</h2>
            <p class="text-[11px] text-gray-400 mb-3">Colonnes attendues : <code>prenom,nom,email,telephone,pharmacie,date_entree</code>. Le nom de pharmacie doit correspondre exactement à une pharmacie existante. Un mot de passe initial est généré pour chaque compte créé et affiché après l'import.</p>
            <form method="POST" action="/admin/preparatrices/import" enctype="multipart/form-data" class="space-y-3 text-sm">
              <input type="file" name="fichier" accept=".csv" required class="w-full text-xs" />
              <button type="submit" class="w-full bg-nm-accent text-white font-semibold rounded-lg py-2.5 text-sm">Importer</button>
            </form>
            <% if (typeof importees !== 'undefined') { %>
              <p class="text-xs text-emerald-500 mt-2"><%= importees %> préparatrice(s) importée(s).</p>
            <% } %>
          </div>
        </div>
        <% } %>
      </div>
    </main>
  </div>

  <script src="/js/admin.js"></script>
</body>
</html>
