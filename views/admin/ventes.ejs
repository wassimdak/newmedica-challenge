<!DOCTYPE html>
<html lang="fr">
<head>
  <%- include('../partials/head', { title: 'Ventes — Back-office NewMedica' }) %>
</head>
<body class="min-h-screen bg-nm-bg">
  <%- include('../partials/admin-mobile-nav', { page }) %>
  <div class="flex flex-col md:flex-row">
    <%- include('../partials/admin-sidebar', { page, admin }) %>

    <main class="flex-1 p-6 md:p-8 max-w-6xl">
      <div class="flex items-center justify-between mb-6">
        <h1 class="text-2xl font-bold text-nm-primary">Ventes</h1>
        <form method="GET" class="flex items-center gap-2">
          <% if (groupeParProduit) { %><input type="hidden" name="vue" value="produit" /><% } %>
          <% if (toutesPeriodes) { %><input type="hidden" name="toutes" value="1" /><% } %>
          <input type="month" name="periode" value="<%= periode %>" class="border border-gray-200 rounded-lg px-3 py-1.5 text-sm" onchange="this.form.submit()" />
        </form>
      </div>

      <div class="grid lg:grid-cols-3 gap-6">
        <div class="lg:col-span-2 nm-card p-4 overflow-x-auto">
          <div class="flex items-center justify-between mb-3 flex-wrap gap-2">
            <div class="flex items-center gap-2">
              <a href="?periode=<%= periode %><%= toutesPeriodes ? '&toutes=1' : '' %>"
                class="text-xs font-semibold px-3 py-1.5 rounded-full <%= !groupeParProduit ? 'bg-nm-primary text-white' : 'bg-gray-100 text-gray-400' %>">Lignes récentes</a>
              <a href="?periode=<%= periode %>&vue=produit<%= toutesPeriodes ? '&toutes=1' : '' %>"
                class="text-xs font-semibold px-3 py-1.5 rounded-full <%= groupeParProduit ? 'bg-nm-primary text-white' : 'bg-gray-100 text-gray-400' %>">Regroupé par produit</a>
            </div>
            <a href="?periode=<%= periode %><%= groupeParProduit ? '&vue=produit' : '' %><%= toutesPeriodes ? '' : '&toutes=1' %>" class="text-[11px] text-nm-primary underline">
              <%= toutesPeriodes ? 'Revenir à ' + periodeLabel : 'Voir toutes les périodes confondues' %>
            </a>
          </div>
          <div class="flex items-center gap-3 mb-3">
            <a href="/admin/export/ventes-produit?periode=<%= periode %><%= toutesPeriodes ? '&toutes=1' : '' %>" class="text-[11px] font-semibold text-nm-primary underline">⬇ Excel — ventes par produit</a>
            <a href="/admin/export/ventes-marque?periode=<%= periode %><%= toutesPeriodes ? '&toutes=1' : '' %>" class="text-[11px] font-semibold text-nm-primary underline">⬇ Excel — ventes par marque</a>
          </div>

          <% if (groupeParProduit) { %>
            <p class="text-xs text-gray-400 mb-2"><%= toutesPeriodes ? 'Toutes périodes confondues' : periodeLabel %> — <%= parProduit.length %> produit(s) vendu(s), triés par quantité décroissante</p>
            <table class="w-full text-sm">
              <thead>
                <tr class="text-left text-xs text-gray-400 border-b">
                  <th class="py-2">Produit</th><th>Référence</th><th>Marque</th><th class="text-right">Quantité totale</th><th class="text-right">Points générés</th>
                </tr>
              </thead>
              <tbody>
                <% parProduit.forEach(p => { %>
                  <tr class="border-b last:border-0">
                    <td class="py-2.5 font-semibold text-nm-primary"><%= p.produit_nom || '—' %></td>
                    <td class="text-gray-500"><%= p.reference %></td>
                    <td class="text-gray-500"><%= p.marque_nom %></td>
                    <td class="text-right font-semibold text-nm-accent"><%= p.volume %></td>
                    <td class="text-right text-gray-500"><%= p.points_generes %></td>
                  </tr>
                <% }) %>
                <% if (parProduit.length === 0) { %><tr><td colspan="5" class="text-gray-400 py-4 text-center">Aucune vente pour cette sélection.</td></tr><% } %>
              </tbody>
            </table>
          <% } else { %>
            <p class="text-xs text-gray-400 mb-2"><%= toutesPeriodes ? 'Toutes périodes confondues' : periodeLabel %> — <%= ventes.length %> ligne(s) récentes</p>
            <table class="w-full text-sm">
              <thead>
                <tr class="text-left text-xs text-gray-400 border-b">
                  <th class="py-2">Préparatrice</th><th>Pharmacie</th><th>Produit</th><th>Marque</th><th class="text-right">Quantité</th><th>Statut</th>
                </tr>
              </thead>
              <tbody>
                <% ventes.forEach(v => { %>
                  <tr class="border-b last:border-0">
                    <td class="py-2.5 font-semibold text-nm-primary"><%= v.prep_prenom %> <%= v.prep_nom %></td>
                    <td class="text-gray-500"><%= v.pharmacie_nom %></td>
                    <td class="text-gray-500"><%= v.produit_nom || '—' %></td>
                    <td class="text-gray-500"><%= v.marque_nom %></td>
                    <td class="text-right text-gray-500"><%= v.quantite %></td>
                    <td><span class="badge-pill"><%= v.statut_validation %></span></td>
                  </tr>
                <% }) %>
                <% if (ventes.length === 0) { %><tr><td colspan="6" class="text-gray-400 py-4 text-center">Aucune vente pour cette sélection.</td></tr><% } %>
              </tbody>
            </table>
          <% } %>
        </div>

        <% if (admin.role !== 'marque_lecture') { %>
        <div class="nm-card p-5 h-fit">
          <h2 class="font-bold text-nm-primary mb-2">Import des ventes (CSV)</h2>
          <p class="text-[11px] text-gray-400 mb-3">
            Colonnes attendues : <code>email,marque,quantite,periode,reference</code> (les deux dernières optionnelles ; périodes au format AAAA-MM ; email = identifiant de la préparatrice).
            <code>reference</code> permet de rattacher la vente à un produit précis (et donc à son barème de points s'il en a un) — voir <a href="/admin/produits" class="underline">Produits</a> ; sans elle, le premier produit de la marque est utilisé.
            Simule l'import fichier plat ou connecteur caisse/ERP décrit au cahier des charges.
          </p>
          <form method="POST" action="/admin/ventes/import" enctype="multipart/form-data" class="space-y-3 text-sm">
            <input type="file" name="fichier" accept=".csv" required class="w-full text-xs" />
            <button type="submit" class="w-full bg-nm-accent text-white font-semibold rounded-lg py-2.5 text-sm">Importer</button>
          </form>
          <% if (typeof importees !== 'undefined') { %>
            <p class="text-xs text-emerald-500 mt-2"><%= importees %> ligne(s) de vente importée(s). Points et challenges recalculés.</p>
          <% } %>
        </div>
        <% } %>
      </div>
    </main>
  </div>
</body>
</html>
