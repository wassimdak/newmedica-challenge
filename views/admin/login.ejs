<!DOCTYPE html>
<html lang="fr">
<head>
  <%- include('../partials/head', { title: 'Back-office — NewMedica Challenge' }) %>
</head>
<body class="min-h-screen nm-gradient flex items-center justify-center p-6">
  <div class="w-full max-w-sm">
    <div class="text-center mb-8">
      <div class="w-16 h-16 rounded-2xl bg-white/15 mx-auto flex items-center justify-center text-3xl mb-4">📊</div>
      <h1 class="text-white text-2xl font-bold">Back-office NewMedica</h1>
      <p class="text-white/70 text-sm mt-1">Pilotage de NewMedica Challenge</p>
    </div>

    <div class="nm-card p-6">
      <% if (error) { %>
        <div class="bg-red-50 text-red-600 text-sm rounded-lg px-3 py-2 mb-4"><%= error %></div>
      <% } %>
      <form method="POST" action="/admin/login" class="space-y-4">
        <div>
          <label class="text-xs font-semibold text-gray-500">Email</label>
          <input type="email" name="email" required placeholder="admin@newmedica.tn"
            class="mt-1 w-full border border-gray-200 rounded-lg px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-nm-accent" />
        </div>
        <div>
          <label class="text-xs font-semibold text-gray-500">Mot de passe</label>
          <input type="password" name="password" required placeholder="••••••••"
            class="mt-1 w-full border border-gray-200 rounded-lg px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-nm-accent" />
        </div>
        <button type="submit" class="w-full bg-nm-primary text-white font-semibold rounded-lg py-2.5 text-sm hover:opacity-90 transition">
          Se connecter
        </button>
      </form>
    </div>

    <p class="text-center text-white/60 text-xs mt-6">
      <a href="/login" class="underline">← Accès application préparatrices</a>
    </p>
  </div>
</body>
</html>
