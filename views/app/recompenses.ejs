<!DOCTYPE html>
<html lang="fr">
<head>
  <%- include('../partials/head', { title: 'Mes récompenses — NewMedica Challenge', pwa: true }) %>
</head>
<body class="min-h-screen bg-nm-bg pb-24">
  <%- include('../partials/impersonation-banner') %>
  <header class="nm-gradient px-5 pt-6 pb-10 rounded-b-3xl">
    <div class="max-w-md mx-auto">
      <h1 class="text-white text-xl font-bold">Mes récompenses</h1>
      <p class="text-white/70 text-xs mt-0.5">Solde et catalogue de points</p>
    </div>
  </header>

  <main class="max-w-md mx-auto px-5 -mt-6">
    <div class="nm-card p-5 text-center">
      <p class="text-xs text-gray-400">Solde de points disponible</p>
      <p id="solde-points" class="text-4xl font-extrabold text-nm-accent mt-1"><%= pointsBalance %></p>
      <p class="text-xs text-gray-400 mt-1">points</p>
    </div>

    <p class="text-sm font-bold text-gray-500 mt-6 mb-2">Catalogue de récompenses</p>
    <div class="grid grid-cols-2 gap-3">
      <% catalogue.forEach(r => { %>
        <div class="nm-card p-3">
          <div class="w-full h-16 rounded-lg bg-nm-bg flex items-center justify-center text-2xl mb-2">
            <%= r.categorie === 'bon_achat' ? '💳' : r.categorie === 'produit' ? '🧴' : r.categorie === 'formation' ? '🎓' : r.categorie === 'evenement' ? '🎉' : '🎁' %>
          </div>
          <p class="text-xs font-semibold text-nm-primary leading-tight"><%= r.nom %></p>
          <p class="text-[11px] text-gray-400 mt-1"><%= r.cout_points %> pts · <%= r.stock %> dispo.</p>
          <button
            class="btn-echanger w-full mt-2 text-[11px] font-semibold py-1.5 rounded-lg <%= pointsBalance >= r.cout_points && r.stock > 0 ? 'bg-nm-primary text-white' : 'bg-gray-100 text-gray-400 cursor-not-allowed' %>"
            data-id="<%= r.id %>" data-cout="<%= r.cout_points %>" data-nom="<%= r.nom %>"
            <%= (pointsBalance >= r.cout_points && r.stock > 0) ? '' : 'disabled' %>>
            <%= r.stock <= 0 ? 'Épuisé' : (pointsBalance >= r.cout_points ? 'Échanger' : 'Insuffisant') %>
          </button>
        </div>
      <% }) %>
    </div>

    <% if (historique.length > 0) { %>
      <p class="text-sm font-bold text-gray-500 mt-6 mb-2">Mes gains</p>
      <div class="nm-card p-4 space-y-2">
        <% historique.forEach(h => { %>
          <div class="flex items-center justify-between text-xs">
            <div>
              <p class="font-semibold text-nm-primary"><%= h.recompense_nom %></p>
              <p class="text-gray-400"><%= new Date(h.date).toLocaleDateString('fr-FR') %></p>
            </div>
            <span class="badge-pill">
              <%= { demande: 'Demandée', valide: 'Validée', livre: 'Livrée', refuse: 'Refusée' }[h.statut] %>
            </span>
          </div>
        <% }) %>
      </div>
    <% } %>

    <% if (gains.length > 0) { %>
      <p class="text-sm font-bold text-gray-500 mt-6 mb-2">Historique des points</p>
      <div class="nm-card p-4 space-y-2 mb-4">
        <% gains.forEach(g => { %>
          <div class="flex items-center justify-between text-xs">
            <span class="text-gray-500"><%= g.motif %></span>
            <span class="font-bold text-emerald-500">+<%= g.montant %></span>
          </div>
        <% }) %>
      </div>
    <% } %>
  </main>

  <div id="toast" class="nm-toast"></div>
  <%- include('../partials/app-nav', { active: 'recompenses' }) %>
  <script src="/js/app.js"></script>
</body>
</html>
