<!DOCTYPE html>
<html lang="fr">
<head>
  <%- include('../partials/head', { title: 'Accueil — NewMedica Challenge', pwa: true }) %>
</head>
<body class="min-h-screen bg-nm-bg pb-24">
  <%- include('../partials/impersonation-banner') %>
  <header class="nm-gradient px-5 pt-6 pb-16 rounded-b-3xl">
    <div class="max-w-md mx-auto flex items-center justify-between">
      <div>
        <p class="text-white/70 text-xs"><%= preparatrice.pharmacie_nom %></p>
        <h1 class="text-white text-xl font-bold">Bonjour, <%= preparatrice.prenom %> 👋</h1>
      </div>
      <a href="/profil" class="relative w-10 h-10 rounded-full bg-white/15 flex items-center justify-center text-white text-lg">
        🔔
        <% if (notifNonLues > 0) { %>
          <span class="absolute -top-1 -right-1 bg-nm-accent text-white text-[10px] rounded-full w-4 h-4 flex items-center justify-center"><%= notifNonLues %></span>
        <% } %>
      </a>
    </div>
  </header>

  <main class="max-w-md mx-auto px-5 -mt-10">
    <div class="nm-card p-5">
      <p class="text-center text-xs font-semibold text-gray-400 uppercase tracking-wide"><%= periodeLabel %></p>
      <div class="flex justify-center my-3">
        <div class="relative w-40 h-40">
          <svg viewBox="0 0 120 120" class="w-40 h-40 -rotate-90">
            <circle cx="60" cy="60" r="54" fill="none" stroke-width="10" class="progress-ring-bg"></circle>
            <%
              const pct = Math.min(progression.pctAtteinte, 100);
              const circ = 2 * Math.PI * 54;
              const offset = circ * (1 - pct / 100);
            %>
            <circle cx="60" cy="60" r="54" fill="none" stroke-width="10" class="progress-ring-fg"
              stroke-dasharray="<%= circ.toFixed(1) %>" stroke-dashoffset="<%= offset.toFixed(1) %>"></circle>
          </svg>
          <div class="absolute inset-0 flex flex-col items-center justify-center">
            <span class="text-3xl font-extrabold text-nm-primary"><%= progression.pctAtteinte %>%</span>
            <span class="text-[11px] text-gray-400">de l'objectif</span>
          </div>
        </div>
      </div>

      <div class="grid grid-cols-2 gap-3 text-center mt-2">
        <div>
          <p class="text-lg font-bold text-nm-primary"><%= progression.ventesRealisees %></p>
          <p class="text-[11px] text-gray-400">unités vendues</p>
        </div>
        <div>
          <p class="text-lg font-bold text-nm-primary"><%= progression.cible %></p>
          <p class="text-[11px] text-gray-400">objectif du mois</p>
        </div>
      </div>

      <% if (progression.pctVsN1 !== null) { %>
        <div class="mt-4 flex items-center justify-center gap-1.5 text-sm">
          <span class="<%= progression.pctVsN1 >= 0 ? 'text-emerald-500' : 'text-red-500' %> font-semibold">
            <%= progression.pctVsN1 >= 0 ? '▲' : '▼' %> <%= Math.abs(progression.pctVsN1) %>%
          </span>
          <span class="text-gray-400">vs l'année dernière (<%= progression.ventesN1 %> unités)</span>
        </div>
      <% } %>
    </div>

    <div class="rounded-2xl shadow p-4 mt-4 flex items-center gap-3 bg-nm-primary">
      <span class="text-2xl">💬</span>
      <p class="text-white text-sm font-medium"><%= message %></p>
    </div>

    <a href="/scanner" class="rounded-2xl shadow p-4 mt-4 flex items-center gap-3 bg-nm-accent hover:opacity-90 transition">
      <span class="text-2xl">📷</span>
      <div>
        <p class="text-white text-sm font-bold">Scanner un ticket de caisse</p>
        <p class="text-white/80 text-[11px]">Détection automatique des produits vendus</p>
      </div>
    </a>

    <div class="grid grid-cols-3 gap-3 mt-4">
      <a href="/challenges" class="nm-card p-3 text-center hover:shadow-md transition">
        <span class="text-2xl block mb-1">🎯</span>
        <span class="text-xs font-semibold text-nm-primary">Mes challenges</span>
      </a>
      <a href="/classement" class="nm-card p-3 text-center hover:shadow-md transition">
        <span class="text-2xl block mb-1">🏆</span>
        <span class="text-xs font-semibold text-nm-primary">Classement</span>
      </a>
      <a href="/recompenses" class="nm-card p-3 text-center hover:shadow-md transition">
        <span class="text-2xl block mb-1">🎁</span>
        <span class="text-xs font-semibold text-nm-primary">Récompenses</span>
      </a>
    </div>

    <div class="nm-card p-4 mt-4 flex items-center justify-between">
      <div>
        <p class="text-xs text-gray-400">Solde de points</p>
        <p class="text-xl font-bold text-nm-accent"><%= pointsBalance %> pts</p>
      </div>
      <a href="/recompenses" class="text-xs font-semibold text-nm-primary bg-nm-bg px-3 py-2 rounded-lg">Échanger →</a>
    </div>
  </main>

  <%- include('../partials/app-nav', { active: 'accueil' }) %>
</body>
</html>
