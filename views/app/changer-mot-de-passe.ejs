<!DOCTYPE html>
<html lang="fr">
<head>
  <%- include('../partials/head', { title: 'Changer mon mot de passe — NewMedica Challenge', pwa: true }) %>
</head>
<body class="min-h-screen nm-gradient flex items-center justify-center p-6">
  <div class="w-full max-w-sm">
    <div class="text-center mb-8">
      <div class="w-16 h-16 rounded-2xl bg-white/15 mx-auto flex items-center justify-center text-3xl mb-4">🔒</div>
      <h1 class="text-white text-2xl font-bold">
        <%= force ? 'Choisis ton mot de passe' : 'Changer mon mot de passe' %>
      </h1>
      <% if (force) { %>
        <p class="text-white/70 text-sm mt-1">Pour ta sécurité, remplace le mot de passe initial avant de continuer.</p>
      <% } %>
    </div>

    <div class="nm-card p-6">
      <% if (error) { %>
        <div class="bg-red-50 text-red-600 text-sm rounded-lg px-3 py-2 mb-4"><%= error %></div>
      <% } %>

      <form method="POST" action="/changer-mot-de-passe" class="space-y-4">
        <div>
          <label class="text-xs font-semibold text-gray-500">Mot de passe actuel</label>
          <input type="password" name="mot_de_passe_actuel" required placeholder="••••••••"
            class="mt-1 w-full border border-gray-200 rounded-lg px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-nm-accent" />
        </div>
        <div>
          <label class="text-xs font-semibold text-gray-500">Nouveau mot de passe</label>
          <input type="password" name="nouveau_mot_de_passe" required minlength="8" placeholder="8 caractères minimum"
            class="mt-1 w-full border border-gray-200 rounded-lg px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-nm-accent" />
        </div>
        <div>
          <label class="text-xs font-semibold text-gray-500">Confirmer le nouveau mot de passe</label>
          <input type="password" name="confirmation" required minlength="8" placeholder="••••••••"
            class="mt-1 w-full border border-gray-200 rounded-lg px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-nm-accent" />
        </div>
        <button type="submit"
          class="w-full bg-nm-accent text-white font-semibold rounded-lg py-2.5 text-sm hover:opacity-90 transition">
          Enregistrer
        </button>
      </form>

      <% if (!force) { %>
        <p class="text-center text-xs text-gray-400 mt-4"><a href="/profil" class="underline">← Retour au profil</a></p>
      <% } %>
    </div>
  </div>
</body>
</html>
